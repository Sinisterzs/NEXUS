{
  "name": "nexus",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:all": "powershell -ExecutionPolicy Bypass -File ./scripts/dev.ps1",
    "check:deps": "powershell -ExecutionPolicy Bypass -File ./scripts/check-deps.ps1",
    "server:dev": "cargo run --manifest-path nexus-server/Cargo.toml",
    "desktop:dev": "tauri dev",
    "desktop:build": "powershell -ExecutionPolicy Bypass -File ./scripts/build-release.ps1",
    "release:update": "powershell -ExecutionPolicy Bypass -File ./scripts/publish-update.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.5",
    "@tauri-apps/plugin-store": "^2.5.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@tauri-apps/cli": "^2.2.4",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
