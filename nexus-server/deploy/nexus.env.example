# NEXUS Backend Environment Configuration (AWS EC2 Linux Production)
# Salve este arquivo como /opt/nexus/.env e aplique permissões restritas:
# chmod 600 /opt/nexus/.env && chown nexus:nexus /opt/nexus/.env

# Conexão com o banco de dados PostgreSQL 16 local (restrito a loopback)
DATABASE_URL=postgres://nexus_app:<SUA_SENHA_AQUI>@127.0.0.1:5432/nexus_db

# Host e Porta do servidor
# Manter SERVER_HOST em 127.0.0.1 faz o NEXUS escutar simultaneamente em:
# 1) Loopback (127.0.0.1:3001)
# 2) Interface privada Tailscale (detectada dinamicamente via `tailscale ip -4`)
SERVER_HOST=127.0.0.1
SERVER_PORT=3001

# Opcional: IP Tailscale estático (caso queira fixar ao invés de auto-detecção)
# TAILSCALE_IP=100.x.y.z

# Sessões e Rate Limiting
SESSION_TTL_HOURS=72
RATE_LIMIT_AUTH_PER_MINUTE=30

# Transição para HTTPS Público e Reverse Proxy (Caddy)
# Ativar quando o Caddy estiver rodando em 127.0.0.1 terminando TLS
# TRUST_PROXY_HEADERS=true
# PUBLIC_FQDN=api.nexus.seudominio.com

# Suporte a WebRTC TURN Relay (coturn)
# TURN_SERVER=turn.nexus.seudominio.com
# TURN_SECRET=<SUA_CHAVE_SECRETA_STATIC_AUTH_SECRET>

# Níveis de Log (journalctl -u nexus -f)
RUST_LOG=info,nexus_server=debug,tower_http=info

# Credenciais Google OAuth (se ativado)
GOOGLE_CLIENT_ID=964906993797-r3v176v8d8b88fo0r9bethub6dr4cre2.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<SEU_GOOGLE_CLIENT_SECRET_SE_APLICAVEL>

# Recuperação de senha por e-mail (Resend HTTPS API)
# Importante: usar URL HTTPS para a página ponte (/reset-password) para compatibilidade com Gmail
NEXUS_EMAIL_PROVIDER=resend
NEXUS_EMAIL_API_KEY=<SUA_CHAVE_RESEND_AQUI>
NEXUS_EMAIL_FROM="NEXUS <onboarding@resend.dev>"
NEXUS_PASSWORD_RESET_URL=https://nexus-api.dynv6.net/reset-password
